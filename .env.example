# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_ENV=development            # development | production
PORT=3000
# SESSION_SECRET: random 32+ byte hex. REQUIRED in production.
# SESSION_SECRET=
# Dashboard login. Defaults (demo / demo-password) work in development only.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# DATA_DIR=./data
# MAX_UPLOAD_BYTES=5242880

# --- PayPal (optional). Without these the app runs in DEMO MODE with synthetic disputes. ---
# Create a sandbox app at https://developer.paypal.com/ and enable the Disputes API.
PAYPAL_ENV=sandbox             # sandbox | live  (live is untested; use sandbox)
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# Reserved development switch only. Submission remains HARD-DISABLED regardless
# of this setting until actual sandbox payload/attachment validation passes.
# SUBMISSIONS_ENABLED=false

# --- AI provider (optional). Without these the analyzer uses a transparent rule-based engine. ---
# Any OpenAI-compatible chat-completions endpoint.
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.openai.com
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
